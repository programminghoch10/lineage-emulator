<remotePackage path="system-images;android-$SDK;$TAG;$ARCH">
    <type-details xsi:type="sys-img:sysImgDetailsType">
        <api-level>$SDK</api-level>
        <tag>
            <id>$TAG</id>
            <display>LineageOS $FTYPE</display>
        </tag>
        <abi>$ARCH</abi>
        <abis>$ARCH</abis>
        <vendor>
            <id>programminghoch10</id>
            <display>programminghoch10</display>
        </vendor>
    </type-details>
    <revision>
        <major>$DATE</major>
    </revision>
    <display-name>LineageOS $LVER $ARCH System Image</display-name>
    <dependencies>
